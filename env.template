# ===========================================
# AIssistant - Environment Configuration
# ===========================================
# Copia este archivo a .env y configura tus valores

# ----- Modo de Despliegue -----
# Opciones: local | hybrid | cloud
DEPLOYMENT_MODE=hybrid

# ----- Modelo de Whisper (Transcripción) -----
# Opciones: tiny | base | small | medium | large | large-v3
# Nota: modelos más grandes = más precisión pero más recursos
WHISPER_MODEL_SIZE=base

# ----- API Keys (Modo Híbrido/Nube) -----
# Deja vacío si usas modo 100% local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPGRAM_API_KEY=

# ----- Seguridad -----
SECRET_KEY=cambia-esto-en-produccion-usa-clave-segura-de-32-chars

# ----- Base de Datos -----
DATABASE_URL=postgresql://aissistant:aissistant_secret@postgres:5432/aissistant_db

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Ollama (Modo Local) -----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ----- Frontend -----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

