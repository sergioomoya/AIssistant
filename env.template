# ===========================================
# AIssistant - Environment Configuration
# ===========================================
# Copia este archivo a .env y configura tus valores

# ----- Modo de Despliegue -----
# Opciones: local | hybrid | cloud
DEPLOYMENT_MODE=hybrid

# ----- Modelo de Whisper (Transcripción Next-Gen 2026) -----
# Opciones: tiny | base | small | medium | large | large-v3 | large-v3-turbo
# Recomendado: large-v3-turbo para mejor precisión
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=auto  # auto, cpu, cuda
WHISPER_COMPUTE_TYPE=int8  # int8 (CPU), float16 (GPU)
WHISPER_VAD_FILTER=true  # Voice Activity Detection

# ----- API Keys (Modo Híbrido/Nube) -----
# Deja vacío si usas modo 100% local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=  # Para DeepSeek R1 API (alternativa a local)

# ----- Seguridad -----
SECRET_KEY=cambia-esto-en-produccion-usa-clave-segura-de-32-chars

# ----- OAuth Providers -----
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ----- Calendar Sync -----
CALENDAR_SYNC_INTERVAL_MINUTES=15
CALENDAR_SYNC_DAYS_AHEAD=7

# ----- Base de Datos -----
DATABASE_URL=postgresql://aissistant:aissistant_secret@postgres:5432/aissistant_db

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Ollama (Modo Local) -----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ----- LLM Provider (Next-Gen 2026) -----
# Usar litellm para abstracción unificada de modelos
LLM_PROVIDER=litellm
# Modelo por defecto: ollama/deepseek-r1 (local), gpt-5.2 (nube)
LLM_MODEL_NAME=ollama/deepseek-r1
# Modelos de respaldo si el principal falla (separados por comas)
LLM_FALLBACK_MODELS=

# ----- HuggingFace (Diarización) -----
# Obtén tu token en: https://huggingface.co/settings/tokens
HF_TOKEN=

# ----- Frontend -----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

